; Inno Setup script for the Ymir Windows installer (Windows 10+).
;
; Build requirements:
;   1. Application build in build\windows\dist\ymir\
;   2. icon.ico in packaging\windows\ (generated by make_icon.py)
;
; Compile with:
;   "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" packaging\windows\installer.iss
; Output written to dist\ymir-windows-setup.exe.

#define MyAppName "Ymir"
#define MyAppVersion "0.7.0"
#define MyAppPublisher "Strange Attractors Music"
#define MyAppURL "https://github.com/Strange-Attractors-Music/ymir"
#define MyAppExeName "ymir.exe"

[Setup]
AppId={{C4585BA2-9D09-4C59-994E-E0DF5A35878B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\Ymir
DefaultGroupName=Ymir
DisableProgramGroupPage=yes
OutputDir=..\..\dist
OutputBaseFilename=ymir-windows-setup
SetupIconFile=icon.ico
UninstallDisplayIcon={app}\icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "startmenuicon"; Description: "Create a Start Menu shortcut"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\..\build\windows\dist\ymir\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "icon.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\icon.ico"; Tasks: startmenuicon
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\icon.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent
